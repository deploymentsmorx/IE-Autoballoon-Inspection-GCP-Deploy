# Neon Postgres (metadata: customer / user / license / job / status)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=change-me
PWD_PEPPER=change-me

# AWS S3 (actual PDF files — input + ballooned output)
# Bucket URL: https://autoballoon-storage-smorx-prod.s3.us-east-1.amazonaws.com/
# Object layout: {AWS_S3_PREFIX}/{username}/{job_id}/{filename}
# Access keys optional: leave blank on EC2 to use the instance IAM role.
# Local-only file storage: clear AWS_S3_BUCKET as well.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=autoballoon-storage-smorx-prod
AWS_REGION=us-east-1
AWS_S3_URL=https://autoballoon-storage-smorx-prod.s3.us-east-1.amazonaws.com
AWS_S3_PREFIX=autoballoon

# Optional: hosted web app origins (comma-separated) for browser access alongside EXE
# Example: CORS_ORIGINS=https://app.smorx.ai,https://autoballoon.smorx.ai
CORS_ORIGINS=
# SMORX_OCR_FALLBACK=1
# SMORX_STRICT_DIM=1
# SMORX_AI_FALLBACK=1
# OPENAI_API_KEY=sk-...
