# Neon Postgres (metadata: customer / user / license / job / status)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=change-me
PWD_PEPPER=change-me

# AWS S3 (actual PDF files — input + ballooned output)
# Leave blank to store files locally under backend/data/jobs/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-2
AWS_S3_PREFIX=autoballoon

# Optional: OCR / AI
# SMORX_OCR_FALLBACK=1
# SMORX_AI_FALLBACK=0
