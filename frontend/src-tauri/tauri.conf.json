{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoBalloon",
  "version": "1.0.0",
  "identifier": "ai.smorx.autoballoon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:9835",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoBalloon & Inspection Software System",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
