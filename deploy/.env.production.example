# Copy to repo root as .env.production (never commit)
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- API (backend container) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string
PWD_PEPPER=generate-another-long-random-string

AWS_S3_BUCKET=autoballoon-storage-smorx-prod
AWS_REGION=us-east-1
AWS_S3_URL=https://autoballoon-storage-smorx-prod.s3.us-east-1.amazonaws.com
# Leave keys blank on EC2 — boto3 uses the instance IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PREFIX=autoballoon

# Web browser origin(s) — must match where users open the web app
# Example: http://YOUR_EC2_IP:8080 or https://app.yourdomain.com
CORS_ORIGINS=http://YOUR_EC2_IP:8080

UVICORN_WORKERS=2

# --- Web build (frontend container) — baked into static JS at build time ---
VITE_API_URL=http://YOUR_EC2_IP:9686

# Optional
# SMORX_OCR_FALLBACK=1
# SMORX_AI_FALLBACK=0
